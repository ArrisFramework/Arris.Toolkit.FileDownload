{
    "name": "karelwintersky/arris.php-file-download",
    "description": "A library to help with creating downloads for files in PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Karel Wintersky",
            "email": "karel.wintersky@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "karelwintersky/arris.toolkit.mimetypes": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Arris\\Toolkit\\": "src/"
        }
    },
    "autoload-dev": {
